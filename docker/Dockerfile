FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG UNIFIED_API_KEY
ARG UNIFIED_MODEL
ARG UNIFIED_BASE_URL
ARG FREELLMAPI_API_KEY
ARG FREELLMAPI_MODEL
ARG FREELLMAPI_BASE_URL
ARG OPENAI_API_KEY

ENV UNIFIED_API_KEY=$UNIFIED_API_KEY
ENV UNIFIED_MODEL=$UNIFIED_MODEL
ENV UNIFIED_BASE_URL=$UNIFIED_BASE_URL
ENV FREELLMAPI_API_KEY=$FREELLMAPI_API_KEY
ENV FREELLMAPI_MODEL=$FREELLMAPI_MODEL
ENV FREELLMAPI_BASE_URL=$FREELLMAPI_BASE_URL
ENV OPENAI_API_KEY=$OPENAI_API_KEY

RUN npm run build

# Runtime: static server only, avoids Vite host checks
FROM node:20-alpine AS runtime
WORKDIR /app

RUN npm install -g serve
COPY --from=build /app/dist ./dist

EXPOSE 4173
# Respect Render's PORT env; default 4173 for local runs
CMD ["sh", "-c", "serve -s dist -l ${PORT:-4173}"]
